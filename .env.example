# Copy to .env to run the bot, or keep per-environment variants alongside it and
# pick one with `uv run hostpost --env NAME`, which reads .env.NAME in place of
# .env (every .env* but this file is gitignored):
#
#   .env.dev              fully local -- a local MySQL and a local fzd-api
#   .env.stage            local bot against the deployed api-stage.fzd.gg / fzd_stage
#   .env.stage-local-api  local bot against a local fzd-api serving fzd_stage
#   .env.prod             the real thing
#
# Whichever you use, the two data targets below must agree. /event_setup and the
# host commands go through FZD_API_BASE_URL and every other command uses the
# DB_* connection directly, so an API pointed at one schema and DB_* at another
# is a setup that looks fine and tests nothing.

# Discord server info
DISCORD_TOKEN=
SERVER_ID=
# Channels for scheduled posts
EVENT_ANNOUNCE_CHANNEL= # e.g. #fzd-events
ENGAGE_CHANNEL= # e.g. #f-zero99-racetrack
VALIDATION_CHANNEL= # e.g. #playground
ERROR_ALERT_CHANNEL_ID= # e.g. #system-stuff

# Hosting schedule embed: the bot edits this message in place. Both may be left
# empty; the host commands then say the board is not configured and skip it.
HOSTING_SCHEDULE_CHANNEL= # e.g. #circuit-crew
HOSTING_SCHEDULE_MESSAGE_ID= # id of the anchor message to keep updated

# Enable testing mode if TEST_FLAG=1
TEST_FLAG=0

# Database connection
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# The FZD API. /event_setup, /update_host_for_event and /remove_host_from_event
# go through it; every other command still uses the connection above. Both are
# optional — left empty, those three commands say the API is not configured and
# the job-management commands are unaffected.
#
# The key is minted on the API host with `uv run api-key-new hostpost`, which
# prints it once. The API stores only its digest, so a lost key means a new one.
FZD_API_BASE_URL= # e.g. https://api.fzd.gg
FZD_API_KEY=
# FZD_API_TIMEOUT_SECONDS=10
